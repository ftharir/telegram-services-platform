# App Configuration
APP_NAME="Telegram Services Platform"
ENVIRONMENT="development"
DEBUG=True

# Telegram Bot Settings
BOT_TOKEN="your_telegram_bot_token_here"
REQUIRED_CHANNELS="@NitroSeenIranBot"
REQUIRED_CHANNEL_IDS="7986360946"

# PostgreSQL Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password_here"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5434
POSTGRES_DB="telegram_platform_db"

# Redis Configuration
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# API Configuration
API_HOST="0.0.0.0"
API_PORT=8000

# RapidSeen (SMM provider) and the "view" service used by the ordering flows
RAPIDSEEN_API_KEY=""
RAPIDSEEN_API_URL="https://rapidseen.com/api/v2"
VIEW_SERVICE_ID=1
VIEW_PRICE_COINS_PER_100=1

# Optional proxy for Telegram, e.g. socks5://127.0.0.1:10808 (leave empty for a direct connection)
TELEGRAM_PROXY_URL=""
